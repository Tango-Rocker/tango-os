[Unit]
Description=EngineOS dev shell autostart
After=engineos-live-setup.service engineos-engine-runner.service NetworkManager.service
Wants=engineos-live-setup.service engineos-engine-runner.service
Conflicts=getty@tty1.service
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=simple
User=dev
SupplementaryGroups=wheel input audio video render docker
PAMName=login
WorkingDirectory=/home/dev
Environment=ENGINEOS_LOG_DIR=/var/log/engineos
Environment=ENGINEOS_ENGINE_SOCKET=/run/engineos/engine-runner.sock
Environment=XDG_SESSION_TYPE=wayland
Environment=ENGINEOS_TERMINAL_REQUIRE_WAYLAND=true
Environment=ENGINEOS_SHELL_BOOTSTRAP=terminal
Environment="ENGINEOS_TERMINAL_SESSION_CMD=engineos-tmux-attach-primary"
UMask=0002
ExecStart=/usr/local/bin/engineos-dev-shell-start
Restart=on-failure
RestartSec=3
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
