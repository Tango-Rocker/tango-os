#!/usr/bin/env bash
set -euo pipefail

TARGET_USER="${ENGINEOS_CODEX_USER:-dev}"
TARGET_HOME="${ENGINEOS_CODEX_HOME:-/home/$TARGET_USER}"
CODEX_BIN="$TARGET_HOME/.local/bin/codex"
LOG_DIR="/var/log/engineos"
LOG="$LOG_DIR/live-codex-setup.log"

log() {
  printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG"
}

best_effort() {
  local label="$1"
  shift
  if "$@"; then
    log "ok: $label"
    return 0
  fi
  log "WARN best-effort failed: $label: $*"
}

if ! install -d -m 2775 -o root -g wheel "$LOG_DIR" 2>/dev/null; then
  LOG="/tmp/engineos-live-codex-setup.log"
fi
touch "$LOG"

if [[ -x "$CODEX_BIN" ]]; then
  best_effort "codex ownership repair" chown -R "$TARGET_USER:$TARGET_USER" "$TARGET_HOME/.codex" "$TARGET_HOME/.local"
  log "codex already installed: $CODEX_BIN"
  best_effort "codex version probe" "$CODEX_BIN" --version
  exit 0
fi

EMBEDDED_CODEX="$TARGET_HOME/.codex/packages/standalone/current/bin/codex"
if [[ -f "$EMBEDDED_CODEX" ]]; then
  best_effort "embedded codex executable bit" chmod 0755 "$EMBEDDED_CODEX"
  best_effort "codex ownership repair" chown -R "$TARGET_USER:$TARGET_USER" "$TARGET_HOME/.codex" "$TARGET_HOME/.local"
  if [[ -x "$CODEX_BIN" ]]; then
    log "codex repaired from embedded payload: $CODEX_BIN"
    best_effort "codex version probe" "$CODEX_BIN" --version
    exit 0
  fi
fi

if ! id "$TARGET_USER" >/dev/null 2>&1; then
  log "ERROR target user missing: $TARGET_USER"
  exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
  log "ERROR curl is required to install Codex CLI"
  exit 1
fi

install -d -m 0755 -o "$TARGET_USER" -g "$TARGET_USER" "$TARGET_HOME/.local/bin"
log "installing Codex CLI for $TARGET_USER with official standalone installer"
runuser -u "$TARGET_USER" -- env HOME="$TARGET_HOME" CODEX_NON_INTERACTIVE=1 \
  sh -c 'curl -fsSL https://chatgpt.com/codex/install.sh | sh' 2>&1 | tee -a "$LOG"

if [[ ! -x "$CODEX_BIN" ]]; then
  log "ERROR installer completed but Codex CLI is missing: $CODEX_BIN"
  exit 1
fi

log "codex installed: $CODEX_BIN"
"$CODEX_BIN" --version | tee -a "$LOG"
