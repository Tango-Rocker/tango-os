#!/usr/bin/env bash
set -euo pipefail

LOG=/var/log/engineos/live-setup.log

log_line() {
  printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"
}

best_effort() {
  local label="$1"
  shift
  if "$@"; then
    log_line "ok: $label"
    return 0
  fi
  log_line "WARN best-effort failed: $label: $*"
}

install -d -m 2775 -o root -g wheel /var/log/engineos
install -d -m 2775 -o root -g wheel /var/lib/engineos
chown root:wheel /var/log/engineos /var/lib/engineos
chmod 2775 /var/log/engineos /var/lib/engineos
touch \
  /var/log/engineos/app.log \
  /var/log/engineos/cube.log \
  /var/log/engineos/doctor-firstboot.log \
  /var/log/engineos/engine-runner.log \
  /var/log/engineos/engine.log \
  /var/log/engineos/live-setup.log \
  /var/log/engineos/runtime-start.log \
  /var/log/engineos/shell.log \
  /var/log/engineos/terminal.log
chown root:wheel \
  /var/log/engineos/app.log \
  /var/log/engineos/cube.log \
  /var/log/engineos/doctor-firstboot.log \
  /var/log/engineos/engine-runner.log \
  /var/log/engineos/engine.log \
  /var/log/engineos/live-setup.log \
  /var/log/engineos/runtime-start.log \
  /var/log/engineos/shell.log \
  /var/log/engineos/terminal.log
chmod 0664 \
  /var/log/engineos/app.log \
  /var/log/engineos/cube.log \
  /var/log/engineos/doctor-firstboot.log \
  /var/log/engineos/engine-runner.log \
  /var/log/engineos/engine.log \
  /var/log/engineos/live-setup.log \
  /var/log/engineos/runtime-start.log \
  /var/log/engineos/shell.log \
  /var/log/engineos/terminal.log

for group in wheel input audio video render; do
  groupadd -f "$group"
done

id dev >/dev/null 2>&1 || {
  log_line "ERROR live user missing: dev"
  exit 1
}
usermod -aG wheel,input,audio,video,render dev
usermod -s /usr/bin/zsh dev
printf 'dev:dev\n' | chpasswd

if command -v udevadm >/dev/null 2>&1; then
  best_effort "udev reload rules" udevadm control --reload-rules
  best_effort "udev trigger input" udevadm trigger --subsystem-match=input
  best_effort "udev trigger drm" udevadm trigger --subsystem-match=drm
  best_effort "udev trigger sound" udevadm trigger --subsystem-match=sound
fi

{
  printf 'EngineOS live setup\n'
  printf 'created_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'profile=enginedev\n'
  if [[ -r /etc/engineos/version ]]; then
    cat /etc/engineos/version
  fi
  id dev
  ls -l /dev/input/event* /dev/input/mouse* 2>/dev/null || printf 'WARN no input devices listed\n'
  uname -a
} >"$LOG"

if command -v eos-doctor >/dev/null 2>&1; then
  if eos-doctor --vm >/var/log/engineos/doctor-firstboot.log 2>&1; then
    log_line "ok: eos-doctor firstboot"
  else
    log_line "WARN best-effort failed: eos-doctor firstboot"
  fi
fi
