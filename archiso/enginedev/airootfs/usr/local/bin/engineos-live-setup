#!/usr/bin/env bash
set -euo pipefail

install -d -m 2775 -o root -g wheel /var/log/engineos
install -d -m 2775 -o root -g wheel /var/lib/engineos
chown root:wheel /var/log/engineos /var/lib/engineos
chmod 2775 /var/log/engineos /var/lib/engineos

for group in wheel input audio video render; do
  groupadd -f "$group"
done

if id dev >/dev/null 2>&1; then
  usermod -aG wheel,input,audio,video,render dev || true
  usermod -s /usr/bin/zsh dev || true
  printf 'dev:dev\n' | chpasswd || true
fi

if command -v udevadm >/dev/null 2>&1; then
  udevadm control --reload-rules || true
  udevadm trigger --subsystem-match=input || true
  udevadm trigger --subsystem-match=drm || true
  udevadm trigger --subsystem-match=sound || true
fi

{
  printf 'EngineOS live setup\n'
  printf 'created_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'profile=enginedev\n'
  if [[ -r /etc/engineos/version ]]; then
    cat /etc/engineos/version
  fi
  id dev || true
  ls -l /dev/input/event* /dev/input/mouse* 2>/dev/null || true
  uname -a
} >/var/log/engineos/live-setup.log

if command -v eos-doctor >/dev/null 2>&1; then
  eos-doctor --vm >/var/log/engineos/doctor-firstboot.log 2>&1 || true
fi
