# EngineOS live users are intentionally allowed direct local device access.
KERNEL=="event*", SUBSYSTEM=="input", GROUP="input", MODE="0666", TAG+="uaccess"
KERNEL=="mouse*", SUBSYSTEM=="input", GROUP="input", MODE="0666", TAG+="uaccess"
KERNEL=="js*", SUBSYSTEM=="input", GROUP="input", MODE="0666", TAG+="uaccess"
KERNEL=="card*", SUBSYSTEM=="drm", GROUP="video", MODE="0660", TAG+="uaccess"
KERNEL=="renderD*", SUBSYSTEM=="drm", GROUP="render", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="sound", GROUP="audio", MODE="0660", TAG+="uaccess"
