#!/usr/bin/env bash
set -euo pipefail

LOG_DIR="${ENGINEOS_LOG_DIR:-/var/log/engineos}"
LOG_FILE="$LOG_DIR/runtime-start.log"
RUNTIME_CONF="${ENGINEOS_RUNTIME_CONF:-/etc/engineos/runtime.conf}"
ENGINEOS_CMD="${ENGINEOS_CMD:-engineos}"
CMDLINE_FILE="${ENGINEOS_PROC_CMDLINE:-/proc/cmdline}"

mkdir -p "$LOG_DIR"

log() {
  printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG_FILE"
}

recovery_hint() {
  log "recovery hint: switch to ${ENGINEOS_RUNTIME_RECOVERY_TTY:-tty2} and run engineos-recovery-help"
  log "recovery logs: engineos logs runtime --last 200"
  log "recovery bundle: engineos crash-bundle"
}

if [[ -r "$RUNTIME_CONF" ]]; then
  # shellcheck disable=SC1090
  source "$RUNTIME_CONF"
fi

if grep -qw 'engineos.noautostart' "$CMDLINE_FILE" 2>/dev/null; then
  log "runtime autostart disabled by kernel command line"
  recovery_hint
  exit 0
fi

if [[ "${ENGINEOS_RUNTIME_AUTOSTART:-1}" != "1" ]]; then
  log "runtime autostart disabled by runtime.conf"
  recovery_hint
  exit 0
fi

MODE="${ENGINEOS_RUNTIME_SHELL_MODE:---tty}"
log "starting EngineOS shell mode=$MODE recovery=${ENGINEOS_RUNTIME_RECOVERY_TTY:-tty2}"

if "$ENGINEOS_CMD" run shell "$MODE" >>"$LOG_FILE" 2>&1; then
  log "EngineOS shell exited cleanly"
else
  rc="$?"
  log "EngineOS shell failed rc=$rc; recovery TTY should remain available"
  recovery_hint
  exit "$rc"
fi
