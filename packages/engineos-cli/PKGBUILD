pkgrel=7
pkgdesc="EngineOS command-line control surface"
arch=('any')
url="https://example.invalid/engineos"
license=('custom:EngineOS-TBD')
depends=('bash' 'coreutils' 'python')
source=()
sha256sums=()

package() {
  local _engineos_root
  _engineos_root="${ENGINEOS_ROOT:-$(cd "$startdir/../.." && pwd -P)}"

  install -Dm755 "$_engineos_root/tools/engineos/engineos" "$pkgdir/usr/bin/engineos"
  install -Dm755 "$_engineos_root/tools/scripts/builder_handoff.sh" "$pkgdir/usr/lib/engineos/scripts/builder_handoff.sh"
