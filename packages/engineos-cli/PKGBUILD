  install -Dm755 "$_engineos_root/tools/scripts/assets.sh" "$pkgdir/usr/lib/engineos/scripts/assets.sh"
  install -Dm755 "$_engineos_root/tools/scripts/artifacts.sh" "$pkgdir/usr/lib/engineos/scripts/artifacts.sh"
  install -Dm755 "$_engineos_root/tools/scripts/release.sh" "$pkgdir/usr/lib/engineos/scripts/release.sh"
  install -Dm755 "$_engineos_root/tools/scripts/terminal_launcher.sh" "$pkgdir/usr/lib/engineos/scripts/terminal_launcher.sh"
  install -Dm755 "$_engineos_root/tools/scripts/capture_frame.sh" "$pkgdir/usr/lib/engineos/scripts/capture_frame.sh"
  install -Dm755 "$_engineos_root/tools/scripts/doctor.sh" "$pkgdir/usr/lib/engineos/scripts/doctor.sh"
  install -Dm755 "$_engineos_root/tools/scripts/input_trace.sh" "$pkgdir/usr/lib/engineos/scripts/input_trace.sh"
  install -Dm755 "$_engineos_root/tools/scripts/logs.sh" "$pkgdir/usr/lib/engineos/scripts/logs.sh"
  install -Dm755 "$_engineos_root/tools/scripts/package_lint.sh" "$pkgdir/usr/lib/engineos/scripts/package_lint.sh"
