  install -Dm755 "$_engineos_root/tools/scripts/shell_runner.sh" "$pkgdir/usr/lib/engineos/scripts/shell_runner.sh"
  install -Dm755 "$_engineos_root/tools/scripts/proof.sh" "$pkgdir/usr/lib/engineos/scripts/proof.sh"
  install -Dm755 "$_engineos_root/tools/scripts/vm.sh" "$pkgdir/usr/lib/engineos/scripts/vm.sh"
  install -Dm755 "$_engineos_root/tools/scripts/usb.sh" "$pkgdir/usr/lib/engineos/scripts/usb.sh"
