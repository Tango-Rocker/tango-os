  install -Dm755 "$_engineos_root/tools/scripts/build_engine.sh" "$pkgdir/usr/lib/engineos/scripts/build_engine.sh"
  install -Dm755 "$_engineos_root/tools/scripts/build_iso.sh" "$pkgdir/usr/lib/engineos/scripts/build_iso.sh"
  install -Dm755 "$_engineos_root/tools/scripts/build_repo.sh" "$pkgdir/usr/lib/engineos/scripts/build_repo.sh"
