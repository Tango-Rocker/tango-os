pkgname=engineos-level-agent
pkgver=0.1.0
pkgrel=4
pkgdesc="EngineOS Quake level generation sidecar for Codex, dgen, QuakeSpasm, and TrenchBroom"
arch=('any')
url="https://example.invalid/engineos"
license=('custom:EngineOS-TBD')
depends=('bash' 'python' 'engineos-tools' 'engineos-quakespasm' 'engineos-ericw-tools')
source=()
sha256sums=()

package() {
  local _engineos_root
  _engineos_root="${ENGINEOS_ROOT:-$(cd "$startdir/../.." && pwd -P)}"

  install -Dm755 "$_engineos_root/tools/level-agent/engineos-level-agent" "$pkgdir/usr/bin/engineos-level-agent"
  install -Dm755 "$_engineos_root/tools/level-agent/engineos-level-agent" "$pkgdir/usr/bin/eos-level-agent"
  install -Dm755 "$_engineos_root/tools/level-agent/engineos_level_agent.py" "$pkgdir/usr/lib/engineos/level-agent/engineos_level_agent.py"
  install -Dm755 "$_engineos_root/tools/scripts/generate_dgen_wad.py" "$pkgdir/usr/lib/engineos/scripts/generate_dgen_wad.py"
  python "$_engineos_root/tools/scripts/generate_dgen_wad.py" --out "$pkgdir/usr/share/engineos/quake/engineos-dgen.wad"
  install -Dm644 "$_engineos_root/LICENSES.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
