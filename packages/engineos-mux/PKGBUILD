pkgname=engineos-mux
pkgver=3.6b
pkgrel=37
_commit=0623d1e968423ad0c192e0d8debf1258671063d5
pkgdesc="EngineOS tmux 3.6b graphical frontend protocol foundation"
arch=('x86_64')
url="https://example.invalid/engineos"
license=('ISC' 'custom:EngineOS-TBD')
depends=('libevent' 'ncurses' 'libutempter' 'systemd-libs' 'json-c')
makedepends=('meson' 'ninja' 'pkgconf' 'gcc' 'systemd' 'autoconf' 'automake')
provides=('engine-mux')
source=(
  "tmux-3.6b-$_commit.tar.gz::https://github.com/tmux/tmux/archive/$_commit.tar.gz"
  '0001-engine-mux-default-socket.patch'
  '0002-engine-mux-in-server-frontend.patch'
  '0003-engine-mux-graphical-client.patch'
  '0004-engine-pane-presentations.patch'
  'engine-mux-frontend.c'
  'engine-mux-frontend.h'
  'engine-pane.c'
  'engine-pane-host.c'
)
sha256sums=('2c212f7ee2d925b01ec20ab5bb3a906c17b6a8652fe521fcaaf498f800b4d1fa'
            '377d8420eb6bf2103bfc429829d90ed542fd9e9202c6780d122cb5ce4665cb5f'
            'c7f3fbcd68f53f4227614e03cfb7e5f91d3069b68ad03dccf4ead6c13c742e11'
            '1d8d061eaa8aca3df1ab4d0517c6fad2d62b7e8fe60e6aac637ed6b1e68febdf'
            '492a467aac874af3b49791e37be5bb572bfcf5eace28574aa514c15d7bc734b9'
            '2fd6e40f84337b276cca20c0b2287d73a65b029d60a6f626bd97db4d7c925bc7'
            'cdad7a4fb6c706fb77863825c42218351cc1d4ab37131a835fc81a7d92967b1a'
