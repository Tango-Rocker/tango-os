+format_cb_pane_presentation(struct format_tree *ft)
+{
+	if (ft->wp == NULL)
+		return (NULL);
+	return (xstrdup(engine_pane_presentation_name(ft->wp)));
+}
+
+static void *
+format_cb_pane_view_mode(struct format_tree *ft)
+{
+	if (ft->wp == NULL)
