+	return (xstrdup(engine_pane_view_mode_name(ft->wp)));
+}
+
+static void *
+format_cb_pane_scope(struct format_tree *ft)
+{
+	if (ft->wp == NULL || ft->wp->engine_scope == NULL)
+		return (NULL);
+	return (xstrdup(ft->wp->engine_scope));
+}
+
+static void *
+format_cb_pane_app_pid(struct format_tree *ft)
+{
