pkgname=engineos-shell
pkgver=0.1.0
pkgrel=83
pkgdesc="EngineOS wlroots shell bootstrap"
arch=('x86_64')
url="https://example.invalid/engineos"
license=('custom:EngineOS-TBD')
depends=('engineos-mux' 'wlroots0.19' 'wayland' 'libinput' 'libxkbcommon' 'libpng' 'libjpeg-turbo' 'json-c' 'fcft' 'pixman' 'ttf-dejavu' 'noto-fonts' 'noto-fonts-cjk' 'noto-fonts-emoji' 'ttf-nerd-fonts-symbols-mono')
makedepends=('meson' 'ninja' 'pkgconf' 'gcc')
source=()
sha256sums=()

build() {
  local _engineos_root
  _engineos_root="${ENGINEOS_ROOT:-$(cd "$startdir/../.." && pwd -P)}"

  meson setup "$srcdir/build" "$_engineos_root/shell" \
    --prefix=/usr \
    --buildtype=plain
  meson compile -C "$srcdir/build"
}

package() {
  local _engineos_root
  _engineos_root="${ENGINEOS_ROOT:-$(cd "$startdir/../.." && pwd -P)}"

  DESTDIR="$pkgdir" meson install -C "$srcdir/build"
  install -Dm644 "$_engineos_root/shell/themes/gruvbox-dark.json" \
    "$pkgdir/etc/engineos/terminal-theme.json"
  install -Dm644 "$_engineos_root/shell/README.md" "$pkgdir/usr/share/engineos-shell/README.md"
  install -Dm644 "$_engineos_root/LICENSES.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
