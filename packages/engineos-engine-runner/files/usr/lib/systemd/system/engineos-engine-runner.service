[Unit]
Description=EngineOS engine runner daemon
After=engineos-live-setup.service
Wants=engineos-live-setup.service

[Service]
Type=simple
Environment=ENGINEOS_ROOT=/
Environment=ENGINEOS_STATE_DIR=/run/engineos
Environment=ENGINEOS_LOG_DIR=/var/log/engineos
Environment=ENGINEOS_ENGINE_SOCKET=/run/engineos/engine-runner.sock
UMask=0002
ExecStartPre=/usr/bin/install -d -m 2775 -o root -g wheel /run/engineos /var/log/engineos /var/lib/engineos
ExecStartPre=/usr/bin/chown root:wheel /run/engineos /var/log/engineos /var/lib/engineos
ExecStartPre=/usr/bin/chmod 2775 /run/engineos /var/log/engineos /var/lib/engineos
ExecStart=/usr/lib/engineos/bin/engine-runner-daemon --daemon --socket /run/engineos/engine-runner.sock
Restart=on-failure
RestartSec=2
StandardOutput=append:/var/log/engineos/engine-runner.log
StandardError=append:/var/log/engineos/engine-runner.log

[Install]
WantedBy=multi-user.target
