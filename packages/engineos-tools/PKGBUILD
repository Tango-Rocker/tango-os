pkgname=engineos-tools
pkgver=0.1.0
pkgrel=59
pkgdesc="EngineOS command, proof, agent, and observability tools"
arch=('any')
url="https://example.invalid/engineos"
license=('custom:EngineOS-TBD')
install=engineos-tools.install
depends=('bash' 'python' 'git' 'ripgrep' 'jq' 'engineos-config' 'engineos-mux')
provides=(
  'engineos-core' 'engineos-cli' 'engineos-package-tools' 'engineos-preflight-tools'
  'engineos-build-tools' 'engineos-deploy-tools' 'engineos-install-tools'
  'engineos-update-tools' 'engineos-admin-tools' 'engineos-validation-tools'
  'engineos-proof-tools' 'engineos-builder-tools' 'engineos-release-tools'
  'engineos-artifact-tools' 'engineos-vm-tools' 'engineos-usb-tools'
  'engineos-secureboot-tools' 'engineos-app-tools' 'engineos-runtime-tools'
  'engineos-asset-tools' 'engineos-capture-tools' 'engineos-input-tools'
  'engineos-observability' 'engineos-agent-runtime' 'engineos-test-tools'
  'engineos-agent-tools'
)
conflicts=("${provides[@]}")
replaces=("${provides[@]}")
source=()
sha256sums=()

package() {
  local _engineos_root
  local _cmd
  _engineos_root="${ENGINEOS_ROOT:-$(cd "$startdir/../.." && pwd -P)}"

  install -Dm755 "$_engineos_root/tools/engineos/eos" "$pkgdir/usr/bin/eos"
  install -Dm755 "$_engineos_root/tools/engineos/engineos" "$pkgdir/usr/bin/engineos"
  install -Dm755 "$_engineos_root/tools/engineos/engine-image-preview" "$pkgdir/usr/bin/engine-image-preview"
  install -Dm755 "$_engineos_root/tools/scripts/recovery_help.sh" \
    "$pkgdir/usr/bin/engineos-recovery-help"
  install -Dm755 "$_engineos_root/tools/engineos/eos-wrapper" "$pkgdir/usr/lib/engineos/eos-wrapper"
  while IFS= read -r _cmd; do
    [[ -n "$_cmd" ]] || continue
    install -Dm755 "$_engineos_root/tools/engineos/eos-wrapper" "$pkgdir/usr/bin/$_cmd"
  done < <(source "$_engineos_root/tools/scripts/common.sh"; engineos_eos_commands)

  install -d -m0755 "$pkgdir/usr/lib/engineos/scripts" "$pkgdir/usr/lib/engineos/eos"
  cp -a "$_engineos_root/tools/scripts"/. "$pkgdir/usr/lib/engineos/scripts/"
  cp -a "$_engineos_root/tools/eos"/. "$pkgdir/usr/lib/engineos/eos/"
  install -Dm755 "$_engineos_root/tests/tmux-text-client.py" \
    "$pkgdir/usr/lib/engineos/eos/test/tmux-text-client.py"
  rm -f "$pkgdir/usr/lib/engineos/scripts"/generate_dgen_wad.py
  rm -rf "$pkgdir/usr/lib/engineos/scripts/__pycache__"
  chmod -R a+rX "$pkgdir/usr/lib/engineos/scripts" "$pkgdir/usr/lib/engineos/eos"
	find "$pkgdir/usr/lib/engineos/scripts" "$pkgdir/usr/lib/engineos/eos" -type f \( -name '*.sh' -o -name '*.py' -o -name '*.ps1' \) -exec chmod 0755 {} +

  install -d -m0755 "$pkgdir/usr/share/engineos"
  cp -a "$_engineos_root/tools/post-install-payload" "$pkgdir/usr/share/engineos/post-install-payload"
  install -Dm644 "$_engineos_root/AGENTS.md" "$pkgdir/usr/share/engineos/AGENTS.md"
  install -Dm644 "$_engineos_root/agentd.md" "$pkgdir/usr/share/engineos/agentd.md"
  install -Dm644 "$_engineos_root/BACKLOG.md" "$pkgdir/usr/share/engineos/BACKLOG.md"
  install -Dm644 "$_engineos_root/CURRENT_STATUS.md" "$pkgdir/usr/share/engineos/CURRENT_STATUS.md"
  install -Dm644 "$_engineos_root/ROADMAP.md" "$pkgdir/usr/share/engineos/ROADMAP.md"
  install -Dm644 "$_engineos_root/.codex/config.toml" "$pkgdir/usr/share/engineos/.codex/config.toml"
  cp -a "$_engineos_root/docs" "$pkgdir/usr/share/engineos/docs"
  cp -a "$_engineos_root/.agents" "$pkgdir/usr/share/engineos/.agents"
  install -Dm755 "$_engineos_root/tools/hooks/git_pre_push_deploy.sh" "$pkgdir/usr/share/engineos/tools/hooks/git_pre_push_deploy.sh"
  install -Dm755 "$_engineos_root/tools/hooks/install_git_push_deploy_hook.sh" "$pkgdir/usr/share/engineos/tools/hooks/install_git_push_deploy_hook.sh"

  install -Dm644 "$_engineos_root/LICENSES.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
