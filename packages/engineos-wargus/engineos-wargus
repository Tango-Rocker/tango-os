#!/usr/bin/env bash
set -euo pipefail

launcher="${ENGINEOS_WARGUS_LAUNCHER:-/home/dev/wargus/launch-linux.sh}"

if [[ ! -x "$launcher" ]]; then
  printf 'engineos-wargus: Wargus launcher is not executable: %s\n' "$launcher" >&2
  exit 127
fi

if [[ "${1:-}" == "--smoke" ]]; then
  shift
  set -- -r -W 1280x720 -c tools/eos-gameplay-smoke.lua "$@"
fi

exec "$launcher" "$@"
