# EngineOS managed zsh defaults for the live dev instance.
export ZSH="${ZSH:-/usr/share/oh-my-zsh}"
export ZSH_DISABLE_COMPFIX=true
export PATH="$HOME/.local/bin:$PATH"

HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=50000
SAVEHIST=50000
setopt append_history
setopt share_history
setopt hist_ignore_all_dups
setopt hist_reduce_blanks
setopt auto_cd
setopt prompt_subst

if [[ -d /usr/share/zsh/site-functions ]]; then
  fpath=(/usr/share/zsh/site-functions $fpath)
fi

ZSH_THEME="${ZSH_THEME:-robbyrussell}"
plugins=(git sudo docker tmux)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit && compinit
  PROMPT='%n@%m:%~%# '
fi

for plugin_file in \
  /usr/share/fzf/key-bindings.zsh \
  /usr/share/fzf/completion.zsh \
  /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
  [[ -r "$plugin_file" ]] && source "$plugin_file"
done

if [[ -r /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh ]]; then
  source /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -al --group-directories-first --git'
else
  alias ll='ls -alF'
fi

if command -v bat >/dev/null 2>&1; then
  alias view='bat'
fi

alias lg='lazygit'
alias engineos-tmux='engineos-tmux-attach-primary'

# Graphical applications must enter through the native mux so their Wayland
# surfaces can be resolved to the pane's transient scope. Calling /usr/bin
# directly here also prevents the scoped child from recursing through this
# interactive-shell function.
falkon() {
  if ! command -v eos-app >/dev/null 2>&1; then
    print -u2 'falkon: eos-app is required for pane-scoped graphical launch'
    return 127
  fi
  eos-app pane launch -- /usr/bin/falkon "$@"
}
