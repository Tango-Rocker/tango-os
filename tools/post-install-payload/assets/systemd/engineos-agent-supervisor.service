[Unit]
Description=EngineOS bounded Codex session supervisor
Documentation=file:///usr/share/engineos/management/INDEX.md
ConditionPathIsDirectory=%h/Tang-OS/.git

[Service]
Type=oneshot
WorkingDirectory=%h/Tang-OS
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/eos-agent supervisor run --root %h/Tang-OS
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=yes
