#!/usr/bin/env bash
set -u

log_warning() {
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/engineos"
  mkdir -p "$state_dir" 2>/dev/null || return 0
  printf '%s tmux-warning %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$state_dir/tmux.log" 2>/dev/null || true
}

if ! command -v eos-app >/dev/null 2>&1; then
  exit 0
fi

eos-app pane sync "$@"
rc=$?
if [[ "$rc" -ne 0 ]]; then
  log_warning "eos-app pane sync $* failed status=$rc"
fi

exit 0
