#!/usr/bin/env bash
set -euo pipefail

LOG_DIR="${ENGINEOS_LOG_DIR:-/var/log/engineos}"
LOG_FILE="$LOG_DIR/dev-shell-start.log"
ENGINEOS_RUNTIME_CMD="${ENGINEOS_RUNTIME_CMD:-eos-runtime}"
CMDLINE_FILE="${ENGINEOS_PROC_CMDLINE:-/proc/cmdline}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
REFRESH_WAYLAND_ON_START="${ENGINEOS_REFRESH_WAYLAND_ON_START:-true}"
MUX_BIN="${ENGINEOS_MUX_BIN:-engine-mux}"

mkdir -p "$LOG_DIR"

log() {
  printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG_FILE"
}

if grep -qw 'engineos.nodevshell' "$CMDLINE_FILE" 2>/dev/null; then
  log "dev shell autostart disabled by kernel command line"
  exit 0
fi

refresh_wayland_session() {
  local pid
  local stale_pids=()
  local waited
  local socket

  if [[ "$REFRESH_WAYLAND_ON_START" != "true" ]]; then
    log "wayland refresh skipped reason=disabled"
    return
  fi

  while IFS= read -r pid; do
    [[ -n "$pid" && "$pid" != "$$" ]] || continue
    stale_pids+=("$pid")
  done < <(pgrep -u "$(id -u)" -x engineos-shell 2>/dev/null || true)

  if (( ${#stale_pids[@]} > 0 )); then
    log "terminating stale engineos-shell processes pids=${stale_pids[*]}"
    kill -TERM "${stale_pids[@]}" 2>/dev/null || true
    for waited in {1..25}; do
      local alive=()
      for pid in "${stale_pids[@]}"; do
        kill -0 "$pid" 2>/dev/null && alive+=("$pid")
      done
      (( ${#alive[@]} == 0 )) && break
      sleep 0.2
    done
    local stubborn=()
    for pid in "${stale_pids[@]}"; do
      kill -0 "$pid" 2>/dev/null && stubborn+=("$pid")
    done
    if (( ${#stubborn[@]} > 0 )); then
      log "killing stale engineos-shell processes pids=${stubborn[*]}"
      kill -KILL "${stubborn[@]}" 2>/dev/null || true
    fi
  fi

  if [[ -d "$RUNTIME_DIR" ]]; then
    for socket in "$RUNTIME_DIR"/wayland-* "$RUNTIME_DIR"/wayland-*.lock; do
      [[ -e "$socket" ]] || continue
      rm -f "$socket"
    done
    log "refreshed wayland runtime dir=$RUNTIME_DIR"
  fi
}

prepare_native_mux() {
  local mux_socket

  [[ "${ENGINEOS_MUX_MODE:-legacy}" == "native" ]] || return 0
  command -v "$MUX_BIN" >/dev/null 2>&1 || {
    log "native mux startup failed reason=missing-engine-mux"
    return 1
  }

  mux_socket="${ENGINEOS_MUX_SOCKET:-$RUNTIME_DIR/engineos/mux.sock}"
  if [[ -n "${ENGINEOS_MUX_SOCKET:-}" ]]; then
    [[ -S "$mux_socket" ]] || {
      log "native mux startup failed reason=configured-socket-missing socket=$mux_socket"
      return 1
    }
    log "using configured native mux socket=$mux_socket"
  else
    if ! "$MUX_BIN" has-session -t '=engineos' 2>/dev/null; then
      log "creating native mux session=engineos"
      "$MUX_BIN" new-session -d -s engineos
    fi
    [[ -S "$mux_socket" ]] || {
      log "native mux startup failed reason=frontend-socket-missing socket=$mux_socket"
      return 1
    }
    log "native mux ready session=engineos socket=$mux_socket"
  fi

  export ENGINEOS_SHELL_BOOTSTRAP=none
}

refresh_wayland_session
prepare_native_mux
log "starting EngineDev shell mode=--tty mux=${ENGINEOS_MUX_MODE:-legacy} bootstrap=${ENGINEOS_SHELL_BOOTSTRAP:-terminal}"

if "$ENGINEOS_RUNTIME_CMD" shell --tty >>"$LOG_FILE" 2>&1; then
  log "EngineDev shell exited cleanly"
else
  rc="$?"
  log "EngineDev shell failed rc=$rc; SSH and recovery login should remain available"
  log "recovery logs: eos-logs shell --last 200; eos-logs runtime --last 200"
  exit "$rc"
fi
