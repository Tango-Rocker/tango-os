#!/usr/bin/env bash
set -u

log_event() {
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/engineos"
  mkdir -p "$state_dir" 2>/dev/null || return 0
  printf '%s pane-bridge deprecated-helper=engineos-tmux-window-sync args=%q\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$state_dir/tmux.log" 2>/dev/null || true
}

log_event "$*"

command -v engineos-tmux-pane-bridge >/dev/null 2>&1 || exit 0
exec engineos-tmux-pane-bridge sync
