#!/usr/bin/env bash
set -euo pipefail

SESSION="${ENGINEOS_TMUX_APP_SESSION:-engineos}"
INTERVAL="${ENGINEOS_TMUX_WINDOW_SYNC_INTERVAL:-2}"
MODE="once"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --daemon)
      MODE="daemon"
      ;;
    --once)
      MODE="once"
      ;;
    help|--help|-h)
      printf 'Usage: engineos-tmux-window-sync [--once|--daemon]\n'
      exit 0
      ;;
    *)
      printf 'engineos-tmux-window-sync: unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
  shift
done

log_warning() {
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/engineos"
  mkdir -p "$state_dir" 2>/dev/null || return 0
  printf '%s tmux-warning %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$state_dir/tmux.log" 2>/dev/null || true
}

pane_matches_window() {
  local pane="$1"
  local app_id="$2"
  local title="$3"
  local pane_window pane_command
  pane_window="$(tmux display-message -pt "$pane" '#{window_name}' 2>/dev/null || true)"
  pane_command="$(tmux display-message -pt "$pane" '#{pane_current_command}' 2>/dev/null || true)"

  local app_l title_l window_l command_l
  app_l="${app_id,,}"
  title_l="${title,,}"
  window_l="${pane_window,,}"
  command_l="${pane_command,,}"
  local haystack="$app_l $title_l"

  case "$command_l" in
    ""|bash|zsh|sh|fish|tmux|node|mc|foot)
      ;;
    *)
      [[ "$haystack" == *"$command_l"* ]] && return 0
      ;;
  esac
  if [[ -n "$window_l" && "$window_l" != gui-* ]]; then
    [[ "$haystack" == *"$window_l"* ]] && return 0
  fi
  return 1
}

prune_stale_bindings() {
  local json="$1"
  local live_ids
  live_ids="$(ENGINEOS_WINDOW_JSON="$json" python - <<'PY'
import json
import os

data = json.loads(os.environ.get("ENGINEOS_WINDOW_JSON", "{}"))
for window in data.get("windows", []):
    window_id = window.get("id")
    if isinstance(window_id, int) and window_id > 0:
        print(window_id)
PY
)"

  while IFS= read -r pane; do
    local existing_id
    existing_id="$(tmux show-options -pt "$pane" -v @engineos-window-id 2>/dev/null || true)"
    [[ "$existing_id" =~ ^[1-9][0-9]*$ ]] || continue
    if grep -Fxq "$existing_id" <<<"$live_ids"; then
      continue
    fi

    local pane_window pane_command
    pane_window="$(tmux display-message -pt "$pane" '#{window_name}' 2>/dev/null || true)"
    pane_command="$(tmux display-message -pt "$pane" '#{pane_current_command}' 2>/dev/null || true)"
    rm -f "${XDG_RUNTIME_DIR:-/tmp}/engineos/window-bounds/$existing_id.env" 2>/dev/null || true
    if [[ "$pane_window" == gui-* ]]; then
      case "$pane_command" in
        bash|zsh|sh|fish)
          tmux kill-window -t "$pane" 2>/dev/null || true
          continue
          ;;
      esac
    fi
    tmux set-option -upt "$pane" @engineos-window-id 2>/dev/null || true
  done < <(tmux list-panes -s -t "$SESSION" -F '#{pane_id}' 2>/dev/null || true)
}

sync_once() {
  command -v tmux >/dev/null 2>&1 || return 0
  command -v eos-app >/dev/null 2>&1 || return 0
  tmux has-session -t "$SESSION" 2>/dev/null || return 0

  local json
  json="$(eos-app window list --json 2>/dev/null)" || return 0
  prune_stale_bindings "$json"
  ENGINEOS_WINDOW_JSON="$json" python - "$SESSION" <<'PY' | while IFS=$'\t' read -r window_id name app_id title focused; do
import json
import os
import re
import sys

session = sys.argv[1]
data = json.loads(os.environ.get("ENGINEOS_WINDOW_JSON", "{}"))
for window in data.get("windows", []):
    if window.get("role") in ("terminal", "terminal-secondary"):
        continue
    window_id = window.get("id")
    if not isinstance(window_id, int):
        continue
    app_id = window.get("app_id") or "app"
    title = window.get("title") or app_id
    label = re.sub(r"[^A-Za-z0-9_.-]+", "-", title or app_id).strip("-")[:24] or "app"
    focused = "true" if bool(window.get("focused", False)) else "false"
    print(f"{window_id}\tgui-{window_id}-{label}\t{app_id}\t{title}\t{focused}")
PY
    [[ -n "$window_id" && -n "$name" ]] || continue
    existing_pane=""
    launcher_pane=""
    duplicate_panes=()
    while IFS= read -r pane; do
      pane_window="$(tmux display-message -pt "$pane" '#{window_name}' 2>/dev/null || true)"
      existing_id="$(tmux show-options -pt "$pane" -v @engineos-window-id 2>/dev/null || true)"
      if [[ "$existing_id" == "$window_id" ]]; then
        if [[ -z "$existing_pane" ]]; then
          existing_pane="$pane"
        fi
        if [[ "$pane_window" != gui-* ]]; then
          existing_pane="$pane"
        elif [[ "$(tmux display-message -pt "$pane" '#{window_active}' 2>/dev/null || true)" == "1" ]]; then
          existing_pane="$pane"
        fi
        if [[ "$pane_window" == gui-* ]]; then
          duplicate_panes+=("$pane")
        fi
      elif [[ -z "$launcher_pane" ]] && pane_matches_window "$pane" "$app_id" "$title"; then
        launcher_pane="$pane"
      fi
    done < <(tmux list-panes -s -t "$SESSION" -F '#{pane_id}' 2>/dev/null || true)
    if [[ -n "$launcher_pane" ]]; then
      existing_pane="$launcher_pane"
      tmux set-option -pt "$existing_pane" -q @engineos-window-id "$window_id" || true
    fi
    if [[ -n "$existing_pane" ]]; then
      for pane in "${duplicate_panes[@]}"; do
        [[ "$pane" != "$existing_pane" ]] || continue
        tmux kill-window -t "$pane" 2>/dev/null || true
      done
      current_name="$(tmux display-message -pt "$existing_pane" '#{window_name}' 2>/dev/null || true)"
      if [[ -n "$current_name" && "$current_name" != "$name" ]]; then
        tmux rename-window -t "$existing_pane" "$name" 2>/dev/null || true
      fi
      eos-app window bind "$window_id" --pane "$existing_pane" >/dev/null 2>&1 ||
        log_warning "eos-app window bind failed window_id=$window_id pane=$existing_pane"
      continue
    fi
    new_pane="$(tmux new-window -P -F '#{pane_id}' -d -t "$SESSION:" -n "$name" "engineos-tmux-window-proxy '$window_id'")" ||
      log_warning "tmux new-window proxy failed window_id=$window_id"
    if [[ -n "${new_pane:-}" ]]; then
      tmux set-option -pt "$new_pane" -q @engineos-window-id "$window_id" || true
      eos-app window bind "$window_id" --pane "$new_pane" >/dev/null 2>&1 ||
        log_warning "eos-app window bind failed window_id=$window_id pane=$new_pane"
      if [[ "$focused" == "true" ]]; then
        new_window_target="$(tmux display-message -pt "$new_pane" '#{session_name}:#{window_index}' 2>/dev/null || true)"
        if [[ -n "$new_window_target" ]]; then
          tmux select-window -t "$new_window_target" 2>/dev/null || true
        fi
      fi
    fi
  done
  if command -v engineos-tmux-window-focus >/dev/null 2>&1; then
    active_pane="$(tmux display-message -p -t "$SESSION:" '#{pane_id}' 2>/dev/null || true)"
    if [[ -n "$active_pane" ]]; then
      TMUX_PANE="$active_pane" engineos-tmux-window-focus || true
    fi
  fi
}

if [[ "$MODE" == "once" ]]; then
  sync_once
  exit 0
fi

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/engineos"
mkdir -p "$runtime_dir" 2>/dev/null || true
lock_dir="$runtime_dir/tmux-window-sync.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT

while true; do
  sync_once || log_warning "tmux window sync pass failed"
  sleep "$INTERVAL"
done
