#!/usr/bin/env python3
import argparse
import json
import os
import signal
import socket
import stat
import subprocess
import sys
import time
from pathlib import Path


MAX_FILE_BYTES = 100 * 1024 * 1024
SUPPORTED_EXTENSIONS = {".png", ".jpg", ".jpeg"}


def error(message: str, code: int = 1) -> int:
    print(f"engine-image-preview: {message}", file=sys.stderr)
    return code


def preview_socket_path() -> str:
    override = os.environ.get("ENGINEOS_PREVIEW_SOCKET")
    if override:
        return override
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if runtime_dir:
        return os.path.join(runtime_dir, "engineos", "preview.sock")
    return "/tmp/engineos/preview.sock"


def shell_state_path() -> Path:
    state_dir = os.environ.get("ENGINEOS_STATE_DIR")
    if state_dir:
        return Path(state_dir) / "shell-state.json"
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if runtime_dir:
        return Path(runtime_dir) / "engineos" / "shell-state.json"
    return Path("/tmp/engineos/shell-state.json")


def shell_slot() -> str | None:
    env_slot = os.environ.get("ENGINEOS_TERMINAL_ROLE") or os.environ.get("ENGINEOS_PREVIEW_SLOT")
    if env_slot in {"terminal", "terminal-secondary"}:
        return env_slot
    try:
        state = json.loads(shell_state_path().read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    active = state.get("active_slot")
    if active in {"terminal", "terminal-secondary"}:
        return str(active)
    return None


def owner_token() -> str:
    override = os.environ.get("ENGINEOS_PREVIEW_OWNER")
    if override:
        return override
    pane = os.environ.get("TMUX_PANE") or "no-pane"
    return f"{os.getppid()}:{os.getpid()}:{pane}"


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def parent_looks_like_mc() -> bool:
    if mc_ancestor_pid() is not None:
        return True
    if os.environ.get("ENGINEOS_PREVIEW_HOLD") == "1":
        return True
    try:
        command = Path(f"/proc/{os.getppid()}/comm").read_text(encoding="utf-8").strip()
    except OSError:
        return False
    return command == "mc"


def parent_pid(pid: int) -> int | None:
    try:
        stat_text = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
    except OSError:
        return None
    end = stat_text.rfind(")")
    if end < 0:
        return None
    fields = stat_text[end + 2 :].split()
    if len(fields) < 2:
        return None
    try:
        return int(fields[1])
    except ValueError:
        return None


def process_comm(pid: int) -> str | None:
    try:
        return Path(f"/proc/{pid}/comm").read_text(encoding="utf-8").strip()
    except OSError:
        return None


def mc_ancestor_pid() -> int | None:
    pid = os.getppid()
    seen: set[int] = set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        if process_comm(pid) == "mc":
            return pid
        next_pid = parent_pid(pid)
        if next_pid is None:
            return None
        pid = next_pid
    return None


def detect_image_kind(path: Path) -> str | None:
    suffix = path.suffix.lower()
    if suffix not in SUPPORTED_EXTENSIONS:
        return None
    try:
        with path.open("rb") as handle:
            header = handle.read(12)
    except OSError:
        return None
    if header.startswith(b"\x89PNG\r\n\x1a\n"):
        return "image/png"
    if header.startswith(b"\xff\xd8\xff"):
        return "image/jpeg"
    return None


def validate_image_path(raw_path: str) -> tuple[Path | None, str | None]:
    path = Path(raw_path).expanduser()
    try:
        resolved = path.resolve(strict=True)
        st = resolved.stat()
    except OSError as exc:
        return None, f"cannot read image path: {exc}"
    if stat.S_ISDIR(st.st_mode):
        return None, "image path is a directory"
    if not stat.S_ISREG(st.st_mode):
        return None, "image path is not a regular file"
    if st.st_size > MAX_FILE_BYTES:
        return None, f"image file is too large: {st.st_size} bytes"
    if detect_image_kind(resolved) is None:
        return None, "unsupported image type; expected PNG or JPEG"
    return resolved, None


def tmux_bounds() -> dict[str, int] | None:
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return None
    try:
        result = subprocess.run(
            [
                "tmux",
                "display-message",
                "-p",
                "-t",
                pane,
                "#{pane_left} #{pane_top} #{pane_width} #{pane_height} #{window_width} #{window_height}",
            ],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=1.0,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    parts = result.stdout.strip().split()
    if len(parts) != 6:
        return None
    try:
        left, top, width, height, window_width, window_height = [int(part) for part in parts]
    except ValueError:
        return None
    if width <= 0 or height <= 0 or window_width <= 0 or window_height <= 0:
        return None
    return {
        "x": left,
        "y": top,
        "width": width,
        "height": height,
        "window_width": window_width,
        "window_height": window_height,
    }


def build_request(args: argparse.Namespace) -> tuple[dict[str, object] | None, str | None]:
    if args.ping:
        return {"version": 1, "op": "ping"}, None
    if args.hide:
        request: dict[str, object] = {"version": 1, "op": "hide"}
        if args.owner:
            request["owner"] = args.owner
        return request, None

    raw_path = args.view or args.open
    if raw_path is None:
        return None, "expected --view PATH, --open PATH, --hide, or --ping"
    path, path_error = validate_image_path(raw_path)
    if path_error is not None or path is None:
        return None, path_error

    request: dict[str, object] = {
        "version": 1,
        "op": "show",
        "path": str(path),
        "anchor": "active-pane",
        "fit": "contain",
        "owner": args.owner or owner_token(),
    }
    slot = shell_slot()
    if slot is not None:
        request["slot"] = slot
    bounds = tmux_bounds()
    if bounds is not None:
        request["bounds"] = bounds
    return request, None


def send_request(request: dict[str, object], sock_path: str) -> tuple[dict[str, object] | None, str | None]:
    payload = (json.dumps(request, separators=(",", ":")) + "\n").encode("utf-8")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(2.0)
            client.connect(sock_path)
            client.sendall(payload)
            chunks: list[bytes] = []
            while True:
                chunk = client.recv(4096)
                if not chunk:
                    break
                chunks.append(chunk)
                if b"\n" in chunk:
                    break
    except OSError as exc:
        return None, f"shell preview IPC unavailable at {sock_path}: {exc}"

    raw = b"".join(chunks).split(b"\n", 1)[0]
    if not raw:
        return None, "shell preview IPC returned an empty response"
    try:
        response = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        return None, f"shell preview IPC returned invalid JSON: {exc}"
    if response.get("status") != "ok":
        message = response.get("error")
        return response, str(message) if message else "shell preview request failed"
    return response, None


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Request an EngineOS shell image preview")
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--view", metavar="PATH", help="show an image from MC View")
    action.add_argument("--open", metavar="PATH", help="show an image from MC Open")
    action.add_argument("--hide", action="store_true", help="hide the active preview")
    action.add_argument("--ping", action="store_true", help="check shell preview IPC")
    parser.add_argument("--socket", help="override the shell preview socket path")
    parser.add_argument("--owner", help=argparse.SUPPRESS)
    parser.add_argument("--wait-pid", type=int, help=argparse.SUPPRESS)
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="validate input and print the IPC JSON without contacting the shell",
    )
    return parser.parse_args(argv)


def wait_then_hide(pid: int, owner: str, sock_path: str) -> int:
    while process_exists(pid):
        time.sleep(0.25)
    _, ipc_error = send_request({"version": 1, "op": "hide", "owner": owner}, sock_path)
    if ipc_error is not None:
        return error(ipc_error, 1)
    return 0


def hold_view_until_closed(owner: str, sock_path: str) -> int:
    done = False

    def stop(_signum: int, _frame: object) -> None:
        nonlocal done
        done = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    parent_pid = mc_ancestor_pid() or os.getppid()
    while not done and process_exists(parent_pid):
        time.sleep(0.25)
    _, ipc_error = send_request({"version": 1, "op": "hide", "owner": owner}, sock_path)
    if ipc_error is not None:
        return error(ipc_error, 1)
    return 0


def start_parent_watcher(parent_pid: int, owner: str, sock_path: str) -> None:
    subprocess.Popen(
        [
            sys.executable,
            str(Path(__file__).resolve()),
            "--hide",
            "--owner",
            owner,
            "--wait-pid",
            str(parent_pid),
            "--socket",
            sock_path,
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    sock_path = args.socket or preview_socket_path()
    if args.wait_pid is not None:
        if not args.owner:
            return error("--wait-pid requires --owner", 2)
        return wait_then_hide(args.wait_pid, args.owner, sock_path)

    request, request_error = build_request(args)
    if request_error is not None or request is None:
        return error(request_error or "failed to build request", 2)

    if args.dry_run:
        print(json.dumps(request, sort_keys=True, separators=(",", ":")))
        return 0

    response, ipc_error = send_request(request, sock_path)
    if ipc_error is not None:
        return error(ipc_error, 1)
    if args.ping:
        caps = response.get("capabilities", []) if response is not None else []
        print("engine-image-preview: shell preview IPC ready", file=sys.stderr)
        if caps:
            print("engine-image-preview: capabilities=" + ",".join(map(str, caps)), file=sys.stderr)
    elif args.view and parent_looks_like_mc():
        return hold_view_until_closed(str(request["owner"]), sock_path)
    elif args.open and parent_looks_like_mc():
        start_parent_watcher(mc_ancestor_pid() or os.getppid(), str(request["owner"]), sock_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
