#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'HELP'
engineos has been split into Unix-style eos-* commands.

Common replacements:
  engineos doctor ...              -> eos-doctor ...
  engineos logs ...                -> eos-logs ...
  engineos crash-bundle ...        -> eos-crash-bundle ...
  engineos build iso ...           -> eos-build iso ...
  engineos build repo ...          -> eos-build repo ...
  engineos package <name> ...      -> eos-package <name> ...
  engineos lint packages ...       -> eos-lint packages ...
  engineos preflight ...           -> eos-preflight ...
  engineos ci ...                  -> eos-ci ...
  engineos dev ...                 -> eos-dev ...
  engineos release checklist ...   -> eos-release checklist ...
  engineos builder handoff ...     -> eos-builder handoff ...
  engineos deploy first ...        -> eos-deploy first ...
  engineos install dev ...         -> eos-install dev ...
  engineos installation-guide      -> eos-install guide
  engineos update check ...        -> eos-update check ...
  engineos app ...                 -> eos-app ...
  engineos terminal ...            -> eos-terminal ...
  engineos outputs ...             -> eos-outputs ...
  engineos game quake ...          -> eos-game quake ...
  engineos run shell ...           -> eos-runtime shell ...
  engineos assets ...              -> eos-assets ...
  engineos capture frame ...       -> eos-capture frame ...
  engineos record input ...        -> eos-input record ...
  engineos replay input ...        -> eos-input replay ...
  engineos proof ...               -> eos-proof ...
  engineos validate ...            -> eos-validate ...
  engineos vm ...                  -> eos-vm ...
  engineos usb ...                 -> eos-usb ...
  engineos secure-boot ...         -> eos-secureboot ...
  engineos agent ...               -> eos-agent ...
  engineos observability ...       -> eos-observe ...
  engineos test ...                -> eos-test ...

Run an eos-* command with --help for domain-specific usage.
HELP
}

replacement_for() {
  local cmd="${1:-help}"
  local next="${2:-}"

  case "$cmd" in
    help|--help|-h)
      usage
      return 0
      ;;
    doctor) printf 'eos-doctor' ;;
    logs) printf 'eos-logs' ;;
    crash-bundle) printf 'eos-crash-bundle' ;;
    build) printf 'eos-build' ;;
    package) printf 'eos-package' ;;
    lint) printf 'eos-lint' ;;
    preflight) printf 'eos-preflight' ;;
    ci) printf 'eos-ci' ;;
    dev) printf 'eos-dev' ;;
    release) printf 'eos-release' ;;
    artifacts) printf 'eos-artifacts' ;;
    builder) printf 'eos-builder' ;;
    bootstrap)
      if [[ "$next" == "builder" ]]; then
        printf 'eos-builder bootstrap'
      else
        printf 'eos-builder'
      fi
      ;;
    deploy) printf 'eos-deploy' ;;
    install) printf 'eos-install' ;;
    installation-guide|install-guide) printf 'eos-install guide' ;;
    update) printf 'eos-update' ;;
    app) printf 'eos-app' ;;
    terminal) printf 'eos-terminal' ;;
    outputs) printf 'eos-outputs' ;;
    run) printf 'eos-runtime' ;;
    game) printf 'eos-game' ;;
    fetch)
      if [[ "$next" == "engine" ]]; then
        printf 'eos-build fetch'
      else
        printf 'eos-build'
      fi
      ;;
    assets) printf 'eos-assets' ;;
    capture) printf 'eos-capture' ;;
    record|replay) printf 'eos-input' ;;
    proof) printf 'eos-proof' ;;
    validate) printf 'eos-validate' ;;
    vm) printf 'eos-vm' ;;
    usb) printf 'eos-usb' ;;
    secure-boot) printf 'eos-secureboot' ;;
    agent) printf 'eos-agent' ;;
    observability) printf 'eos-observe' ;;
    test) printf 'eos-test' ;;
    *)
      printf ''
      return 1
      ;;
  esac
}

main() {
  local replacement
  if [[ $# -eq 0 || "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    return 0
  fi

  replacement="$(replacement_for "${1:-}" "${2:-}")" || {
    printf 'engineos: unknown legacy command: %s\n\n' "${1:-}" >&2
    usage >&2
    return 2
  }

  printf 'engineos no longer executes subcommands.\n' >&2
  printf 'Use: %s' "$replacement" >&2

  case "${1:-}" in
    bootstrap)
      if [[ "${2:-}" == "builder" ]]; then
        shift 2 || true
      else
        shift || true
      fi
      ;;
    installation-guide|install-guide)
      shift || true
      ;;
    engine)
      shift || true
      ;;
    fetch)
      shift || true
      ;;
    record|replay)
      local action="$1"
      shift || true
      if [[ "${1:-}" == "input" ]]; then
        shift || true
      fi
      set -- "$action" "$@"
      ;;
    run)
      shift || true
      ;;
    observability)
      shift || true
      ;;
    *)
      shift || true
      ;;
  esac

  if [[ $# -gt 0 ]]; then
    printf ' ' >&2
    printf '%q ' "$@" >&2
  fi
  printf '\n' >&2
  return 2
}

main "$@"
