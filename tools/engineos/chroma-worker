#!/usr/bin/env python3
"""Durable single-writer Chroma generation worker."""

import argparse
import base64
import contextlib
import json
import os
import signal
import socket
import socketserver
import sqlite3
import subprocess
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

PROTOCOL = "chroma-worker/v1"
MAX_ATTEMPTS = 3


def xdg_path(variable: str, fallback: Path) -> Path:
    value = os.environ.get(variable)
    return Path(value) if value else fallback


def process_matches(pid: int, executable: str, port: int) -> bool:
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
    except OSError:
        return False
    decoded = [item.decode(errors="replace") for item in cmdline if item]
    expected = Path(executable).resolve()
    candidates = [Path(item).resolve() for item in decoded[:2]]
    return expected in candidates and str(port) in decoded


class Worker:
    def __init__(self) -> None:
        home = Path.home()
        runtime = xdg_path("XDG_RUNTIME_DIR", Path(f"/tmp/engineos-{os.getuid()}"))
        state = xdg_path("XDG_STATE_HOME", home / ".local/state")
        self.socket_path = Path(
            os.environ.get("CHROMA_WORKER_SOCKET", runtime / "chroma/worker.sock")
        )
        self.db_path = Path(
            os.environ.get("CHROMA_WORKER_DB", state / "chroma/queue.sqlite3")
        )
        self.legacy_db = Path(
            os.environ.get(
                "CHROMA_WORKER_LEGACY_DB",
                home
                / "stable-diffusion.cpp-pipefusion/out/chroma_launcher_queue.sqlite3",
            )
        )
        self.log_dir = state / "chroma/logs"
        self.db_lock = threading.RLock()
        self.condition = threading.Condition()
        self.cancelled: set[int] = set()
        self.paused = False
        self.stopping = False
        self.active_job: int | None = None
        self.server_process: subprocess.Popen[bytes] | None = None
        self.server_pid = 0
        self.server_key = ""
        self._prepare_storage()
        self.thread = threading.Thread(target=self._run_queue, daemon=True)

    def _prepare_storage(self) -> None:
        self.db_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.log_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        new_database = not self.db_path.exists()
        with self.connect() as db:
            db.executescript(
                """
                PRAGMA journal_mode=WAL;
                CREATE TABLE IF NOT EXISTS jobs (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    status TEXT NOT NULL,
                    payload TEXT NOT NULL,
                    attempts INTEGER NOT NULL DEFAULT 0,
                    outputs TEXT NOT NULL,
                    error TEXT NOT NULL DEFAULT '',
                    created_at REAL NOT NULL,
                    updated_at REAL NOT NULL
                );
                CREATE TABLE IF NOT EXISTS metadata (
                    key TEXT PRIMARY KEY,
                    value TEXT NOT NULL
                );
                """
            )
            db.execute(
                "UPDATE jobs SET status='queued', error='recovered after worker restart', updated_at=? "
                "WHERE status='running'",
                (time.time(),),
            )
        if new_database and self.legacy_db.is_file():
            self._migrate_legacy()
        with self.connect() as db:
            self.paused = (
                self._metadata(db, "paused", "0") == "1"
            )
            self.server_pid = int(self._metadata(db, "server_pid", "0"))
            self.server_key = self._metadata(db, "server_key", "")

    def connect(self) -> sqlite3.Connection:
        db = sqlite3.connect(self.db_path, timeout=30)
        db.row_factory = sqlite3.Row
        return db

    @staticmethod
    def _metadata(db: sqlite3.Connection, key: str, default: str) -> str:
        row = db.execute("SELECT value FROM metadata WHERE key=?", (key,)).fetchone()
        return str(row[0]) if row else default

    @staticmethod
    def _set_metadata(db: sqlite3.Connection, key: str, value: str) -> None:
        db.execute(
            "INSERT INTO metadata(key,value) VALUES(?,?) "
            "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
            (key, value),
        )

    def _migrate_legacy(self) -> None:
        legacy: sqlite3.Connection | None = None
        try:
            legacy = sqlite3.connect(self.legacy_db)
            legacy.row_factory = sqlite3.Row
            rows = legacy.execute("SELECT * FROM jobs ORDER BY id").fetchall()
        except sqlite3.Error:
            return
        finally:
            with contextlib.suppress(Exception):
                assert legacy is not None
                legacy.close()
        with self.connect() as db:
            for row in rows:
                settings = json.loads(row["settings"])
                payload = {
                    "settings": settings,
                    "prompt": row["prompt"],
                    "negative_prompt": row["negative_prompt"],
                }
                status = {
                    "done": "completed",
                    "running": "queued",
                }.get(row["status"], row["status"])
                outputs = self._reserve_outputs(db, settings)
                db.execute(
                    "INSERT INTO jobs(status,payload,attempts,outputs,error,created_at,updated_at) "
                    "VALUES(?,?,?,?,?,?,?)",
                    (
                        status,
                        json.dumps(payload),
                        int(row["attempt"]),
                        json.dumps(outputs),
                        str(row["error"] or ""),
                        time.time(),
                        time.time(),
                    ),
                )
            self._set_metadata(db, "legacy_migrated_from", str(self.legacy_db))
            db.commit()

    def _reserve_outputs(
        self, db: sqlite3.Connection, settings: dict[str, Any]
    ) -> list[str]:
        output_dir = Path(str(settings["OutDir"])).expanduser().resolve()
        output_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        count = max(1, int(settings.get("BatchCount", 1)))
        existing = -1
        for path in output_dir.glob("*.png"):
            prefix = path.name.split("-", 1)[0]
            if prefix.isdigit():
                existing = max(existing, int(prefix))
        reserved = existing
        for row in db.execute("SELECT outputs FROM jobs"):
            with contextlib.suppress(json.JSONDecodeError):
                for raw in json.loads(row[0]):
                    path = Path(raw)
                    if path.parent == output_dir:
                        prefix = path.name.split("-", 1)[0]
                        if prefix.isdigit():
                            reserved = max(reserved, int(prefix))
        begin = reserved + 1
        size = f"{int(settings['Width'])}x{int(settings['Height'])}"
        steps = int(settings["Steps"])
        cfg = str(float(settings["CfgScale"]))
        return [
            str(output_dir / f"{index:03d}-{size}-{steps}-{cfg}.png")
            for index in range(begin, begin + count)
        ]

    def start(self) -> None:
        self.thread.start()

    def _server_log_path(self, settings: dict[str, Any]) -> Path:
        return self.log_dir / f"sd-server-{int(settings['ServerPort'])}.log"

    def snapshot(self) -> dict[str, Any]:
        with self.db_lock, self.connect() as db:
            rows = []
            for row in db.execute("SELECT * FROM jobs ORDER BY id"):
                payload = json.loads(row["payload"])
                rows.append({
                    "id": row["id"],
                    "status": row["status"],
                    "payload": payload,
                    "attempts": row["attempts"],
                    "outputs": json.loads(row["outputs"]),
                    "server_log": str(
                        self._server_log_path(payload["settings"])
                    ),
                    "error": row["error"],
                    "created_at": row["created_at"],
                    "updated_at": row["updated_at"],
                })
        server_log: str | None = None
        active = next(
            (row for row in rows if row["id"] == self.active_job), None
        )
        if active is not None:
            server_log = str(active["server_log"])
        elif self.server_pid and self.server_key:
            with contextlib.suppress(
                json.JSONDecodeError, IndexError, TypeError, ValueError
            ):
                key = json.loads(self.server_key)
                server_log = str(self.log_dir / f"sd-server-{int(key[1])}.log")
        return {
            "protocol": PROTOCOL,
            "paused": self.paused,
            "active_job": self.active_job,
            "server_pid": self.server_pid or None,
            "log_dir": str(self.log_dir),
            "server_log": server_log,
            "jobs": rows,
        }

    def operation(self, request: dict[str, Any]) -> dict[str, Any]:
        if request.get("protocol") != PROTOCOL:
            raise ValueError(f"protocol must be {PROTOCOL}")
        op = request.get("op")
        if op == "snapshot":
            return self.snapshot()
        if op == "enqueue":
            payload = request.get("payload")
            if not isinstance(payload, dict) or not isinstance(
                payload.get("settings"), dict
            ):
                raise ValueError("enqueue requires payload.settings")
            settings = payload["settings"]
            for key in ("OutDir", "Width", "Height", "Steps", "CfgScale"):
                if key not in settings:
                    raise ValueError(f"enqueue settings missing {key}")
            with self.db_lock, self.connect() as db:
                db.execute("BEGIN IMMEDIATE")
                outputs = self._reserve_outputs(db, settings)
                now = time.time()
                cursor = db.execute(
                    "INSERT INTO jobs(status,payload,outputs,created_at,updated_at) "
                    "VALUES('queued',?,?,?,?)",
                    (json.dumps(payload), json.dumps(outputs), now, now),
                )
                db.commit()
                job_id = int(cursor.lastrowid)
            with self.condition:
                self.condition.notify_all()
            return {"protocol": PROTOCOL, "job_id": job_id, "outputs": outputs}
        if op == "remove":
            job_id = int(request["job_id"])
            with self.db_lock, self.connect() as db:
                row = db.execute(
                    "SELECT status FROM jobs WHERE id=?", (job_id,)
                ).fetchone()
                if not row:
                    raise ValueError("unknown job")
                if row["status"] == "running":
                    raise ValueError("cannot remove a running job")
                db.execute("DELETE FROM jobs WHERE id=?", (job_id,))
                db.commit()
            return {"protocol": PROTOCOL, "removed": job_id}
        if op in ("pause", "resume"):
            self.paused = op == "pause"
            with self.db_lock, self.connect() as db:
                self._set_metadata(db, "paused", "1" if self.paused else "0")
                db.commit()
            with self.condition:
                self.condition.notify_all()
            return {"protocol": PROTOCOL, "paused": self.paused}
        if op == "cancel":
            job_id = int(request["job_id"])
            self.cancelled.add(job_id)
            with self.db_lock, self.connect() as db:
                db.execute(
                    "UPDATE jobs SET status='cancelled',updated_at=? "
                    "WHERE id=? AND status='queued'",
                    (time.time(), job_id),
                )
                db.commit()
            return {"protocol": PROTOCOL, "cancelled": job_id}
        if op == "stop-server":
            self.stop_server()
            return {"protocol": PROTOCOL, "server_pid": None}
        raise ValueError(f"unsupported operation: {op}")

    def _next_job(self) -> sqlite3.Row | None:
        with self.db_lock, self.connect() as db:
            return db.execute(
                "SELECT * FROM jobs WHERE status='queued' ORDER BY id LIMIT 1"
            ).fetchone()

    def _set_job(
        self, job_id: int, status: str, error: str = "", attempts: int | None = None
    ) -> None:
        with self.db_lock, self.connect() as db:
            if attempts is None:
                db.execute(
                    "UPDATE jobs SET status=?,error=?,updated_at=? WHERE id=?",
                    (status, error, time.time(), job_id),
                )
            else:
                db.execute(
                    "UPDATE jobs SET status=?,error=?,attempts=?,updated_at=? WHERE id=?",
                    (status, error, attempts, time.time(), job_id),
                )
            db.commit()

    def _run_queue(self) -> None:
        while not self.stopping:
            if self.paused:
                with self.condition:
                    self.condition.wait(timeout=0.5)
                continue
            row = self._next_job()
            if row is None:
                with self.condition:
                    self.condition.wait(timeout=0.5)
                continue
            job_id = int(row["id"])
            attempts = int(row["attempts"]) + 1
            self.active_job = job_id
            self._set_job(job_id, "running", attempts=attempts)
            try:
                self._generate(row, attempts)
            except Exception as exc:
                if job_id in self.cancelled:
                    self._set_job(job_id, "cancelled", str(exc), attempts)
                elif attempts < MAX_ATTEMPTS:
                    self.stop_server()
                    self._set_job(job_id, "queued", str(exc), attempts)
                else:
                    self._set_job(job_id, "failed", str(exc), attempts)
            else:
                if job_id in self.cancelled:
                    self._set_job(job_id, "cancelled", "cancelled", attempts)
                else:
                    self._set_job(job_id, "completed", attempts=attempts)
            finally:
                self.cancelled.discard(job_id)
                self.active_job = None

    def _server_args(self, settings: dict[str, Any]) -> list[str]:
        if isinstance(settings.get("ServerArgs"), list):
            return [str(item) for item in settings["ServerArgs"]]
        args = [
            "--listen-ip",
            "127.0.0.1",
            "--listen-port",
            str(int(settings["ServerPort"])),
            "--diffusion-model",
            str(settings["DiffusionModel"]),
            "--vae",
            str(settings["Vae"]),
            "--t5xxl",
            str(settings["T5xxl"]),
            "--main-backend-device",
            str(settings["MainBackend"]),
            "--diffusion-backend-device",
            str(settings["DiffusionBackend"]),
            "--clip-backend-device",
            str(settings["ClipBackend"]),
            "--vae-backend-device",
            str(settings["VaeBackend"]),
        ]
        if settings.get("OffloadToCpu"):
            args.append("--offload-to-cpu")
        if settings.get("VaeTiling"):
            args.append("--vae-tiling")
        if settings.get("ChromaDisableDitMask"):
            args.append("--chroma-disable-dit-mask")
        if settings.get("Verbose"):
            args.append("-v")
        return args

    @staticmethod
    def _server_ready(port: int) -> bool:
        try:
            with urllib.request.urlopen(
                f"http://127.0.0.1:{port}/", timeout=0.5
            ):
                return True
        except urllib.error.HTTPError:
            return True
        except (OSError, urllib.error.URLError):
            return False

    def _server_env(self, settings: dict[str, Any]) -> dict[str, str]:
        env = os.environ.copy()
        controlled = [
            "SD_FLUX_STAGE_CACHE",
            "SD_FLUX_CFG_PIPELINE",
            "SD_FLUX_STAGE_TIMING",
            "SD_FLUX_STAGE1_STRIDE",
            "SD_FLUX_STAGE_BACKEND2",
            "SD_FLUX_STAGE_SPLIT",
            "SD_FLUX_STAGE3_SINGLE_SPLIT",
            "SD_FLUX_STAGE_BACKEND3",
            "SD_FLUX_TP_DEBUG",
            "GGML_VK_FORCE_DEQUANT_Q4_0",
            "GGML_VK_FORCE_DEQUANT_Q4_0_MATMUL",
            "GGML_VK_FORCE_DEQUANT_Q4_0_MATVEC",
            "GGML_VK_FORCE_DEQUANT_Q4_0_MATMUL_ID",
            "GGML_VK_FORCE_DEQUANT_Q4_0_MATVEC_ID",
            "SD_SAMPLE_TIMING",
            "SD_PROMPT_CACHE_LOG",
            "SD_PROMPT_CACHE_REFRESH",
        ]
        for key in controlled:
            env.pop(key, None)
        env.update(
            {
                "SD_PRIVACY_REDACT_PROMPT": "1",
                "SD_SERVER_LOG_FILE": str(
                    self.log_dir / f"sd-server-{int(settings['ServerPort'])}.log"
                ),
                "SD_PROMPT_CACHE": "1",
                "SD_PROMPT_CACHE_DIR": str(self.db_path.parent / "prompt-cache"),
                "SD_PROMPT_HOT_CACHE": "1",
            }
        )
        stage_mode = str(settings.get("StageMode", "Single GPU"))
        if stage_mode != "Single GPU":
            env["SD_FLUX_STAGE_CACHE"] = (
                "1" if settings.get("StageCache") else "0"
            )
            env["SD_FLUX_CFG_PIPELINE"] = "1"
            env["SD_FLUX_STAGE1_STRIDE"] = "1"
            env["SD_FLUX_STAGE_BACKEND2"] = str(
                settings.get("StageBackend2", "")
            )
            env["SD_FLUX_STAGE_SPLIT"] = str(settings.get("StageSplit", 10))
            use_stage3 = stage_mode == "Three-stage 1024" or (
                stage_mode == "Auto optimized"
                and int(settings["Width"]) >= 1024
                and int(settings["Height"]) >= 1024
            )
            if use_stage3:
                env["SD_FLUX_STAGE3_SINGLE_SPLIT"] = "14"
                if str(settings.get("StageBackend3", "")).strip():
                    env["SD_FLUX_STAGE_BACKEND3"] = str(
                        settings["StageBackend3"]
                    ).strip()
        if settings.get("StageTiming"):
            env["SD_FLUX_STAGE_TIMING"] = "1"
        if settings.get("TensorDebug"):
            env["SD_FLUX_TP_DEBUG"] = "1"
        if settings.get("SampleTiming"):
            env["SD_SAMPLE_TIMING"] = "1"
        if settings.get("PromptCacheLog"):
            env["SD_PROMPT_CACHE_LOG"] = "1"
        if settings.get("RefreshPromptCache"):
            env["SD_PROMPT_CACHE_REFRESH"] = "1"
        kernel = {
            "dequant-all": "GGML_VK_FORCE_DEQUANT_Q4_0",
            "dequant-matmul": "GGML_VK_FORCE_DEQUANT_Q4_0_MATMUL",
            "dequant-matvec": "GGML_VK_FORCE_DEQUANT_Q4_0_MATVEC",
            "dequant-matmul-id": "GGML_VK_FORCE_DEQUANT_Q4_0_MATMUL_ID",
            "dequant-matvec-id": "GGML_VK_FORCE_DEQUANT_Q4_0_MATVEC_ID",
        }.get(str(settings.get("KernelMode", "direct")))
        if kernel:
            env[kernel] = "1"
        return env

    def _ensure_server(self, settings: dict[str, Any]) -> None:
        executable = str(settings["Server"])
        port = int(settings["ServerPort"])
        key = json.dumps(
            [executable, port, self._server_args(settings)], separators=(",", ":")
        )
        if self._server_ready(port):
            if self.server_pid and self.server_key == key and process_matches(
                self.server_pid, executable, port
            ):
                return
            raise RuntimeError(
                f"refusing unknown process already listening on server port {port}"
            )
        self.stop_server()
        log_path = self._server_log_path(settings)
        log = open(log_path, "ab", buffering=0)
        try:
            self.server_process = subprocess.Popen(
                [executable, *self._server_args(settings)],
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                env=self._server_env(settings),
                start_new_session=True,
            )
        finally:
            log.close()
        self.server_pid = int(self.server_process.pid)
        self.server_key = key
        with self.db_lock, self.connect() as db:
            self._set_metadata(db, "server_pid", str(self.server_pid))
            self._set_metadata(db, "server_key", key)
            db.commit()
        for _ in range(120):
            if self.server_process.poll() is not None:
                raise RuntimeError(
                    f"sd-server exited with {self.server_process.returncode}"
                )
            if self._server_ready(port):
                return
            time.sleep(0.5)
        raise RuntimeError("sd-server did not become ready")

    def _generate(self, row: sqlite3.Row, attempt: int) -> None:
        job_id = int(row["id"])
        payload = json.loads(row["payload"])
        settings = payload["settings"]
        outputs = [Path(item) for item in json.loads(row["outputs"])]
        if outputs and all(path.is_file() and path.stat().st_size > 0 for path in outputs):
            return
        for output in outputs:
            for temporary in output.parent.glob(
                f".{output.name}.job-{job_id}.attempt-*.tmp"
            ):
                with contextlib.suppress(OSError):
                    temporary.unlink()
        self._ensure_server(settings)
        body = {
            "prompt": str(payload.get("prompt", "")),
            "negative_prompt": str(payload.get("negative_prompt", "")),
            "width": int(settings["Width"]),
            "height": int(settings["Height"]),
            "steps": int(settings["Steps"]),
            "cfg_scale": float(settings["CfgScale"]),
            "seed": int(settings.get("Seed", -1)),
            "batch_size": len(outputs),
            "sampler_name": str(settings.get("SamplingMethod", "euler")),
        }
        request = urllib.request.Request(
            f"http://127.0.0.1:{int(settings['ServerPort'])}/sdapi/v1/txt2img",
            data=json.dumps(body).encode(),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(request, timeout=86400) as response:
            result = json.loads(response.read().decode())
        images = result.get("images")
        if isinstance(images, str):
            images = [images]
        if not isinstance(images, list) or len(images) != len(outputs):
            raise RuntimeError(
                f"backend returned {len(images) if isinstance(images, list) else 0} "
                f"images; expected {len(outputs)}"
            )
        for index, (encoded, output) in enumerate(zip(images, outputs)):
            if job_id in self.cancelled:
                raise RuntimeError("cancelled")
            if output.is_file() and output.stat().st_size > 0:
                continue
            output.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            temporary = output.with_name(
                f".{output.name}.job-{job_id}.attempt-{attempt}.{index}.tmp"
            )
            encoded = str(encoded).split(",", 1)[-1]
            data = base64.b64decode(encoded, validate=True)
            with open(temporary, "wb") as handle:
                handle.write(data)
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(temporary, output)
            directory = os.open(output.parent, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)

    def stop_server(self) -> None:
        process = self.server_process
        if process is not None and process.poll() is None:
            process.terminate()
            with contextlib.suppress(subprocess.TimeoutExpired):
                process.wait(timeout=5)
            if process.poll() is None:
                process.kill()
        elif self.server_pid and self.server_key:
            with contextlib.suppress(
                json.JSONDecodeError, IndexError, TypeError, ProcessLookupError
            ):
                key = json.loads(self.server_key)
                if process_matches(self.server_pid, key[0], int(key[1])):
                    os.kill(self.server_pid, signal.SIGTERM)
        self.server_process = None
        self.server_pid = 0
        self.server_key = ""
        with self.db_lock, self.connect() as db:
            self._set_metadata(db, "server_pid", "0")
            self._set_metadata(db, "server_key", "")
            db.commit()

    def close(self) -> None:
        self.stopping = True
        with self.condition:
            self.condition.notify_all()
        self.stop_server()


class RequestHandler(socketserver.StreamRequestHandler):
    def handle(self) -> None:
        raw = self.rfile.readline(1024 * 1024)
        try:
            request = json.loads(raw)
            result = self.server.worker.operation(request)  # type: ignore[attr-defined]
            response = {"ok": True, **result}
        except Exception as exc:
            response = {"ok": False, "protocol": PROTOCOL, "error": str(exc)}
        self.wfile.write(json.dumps(response, separators=(",", ":")).encode() + b"\n")


class Server(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True
    allow_reuse_address = True


def serve() -> int:
    worker = Worker()
    worker.socket_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with contextlib.suppress(FileNotFoundError):
        worker.socket_path.unlink()
    server = Server(str(worker.socket_path), RequestHandler)
    server.worker = worker  # type: ignore[attr-defined]
    os.chmod(worker.socket_path, 0o600)
    worker.start()

    def shutdown(_signum: int, _frame: Any) -> None:
        threading.Thread(target=server.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    try:
        server.serve_forever(poll_interval=0.25)
    finally:
        server.server_close()
        worker.close()
        with contextlib.suppress(FileNotFoundError):
            worker.socket_path.unlink()
    return 0


def request(operation: str, payload: str | None) -> int:
    runtime = xdg_path("XDG_RUNTIME_DIR", Path(f"/tmp/engineos-{os.getuid()}"))
    path = Path(
        os.environ.get("CHROMA_WORKER_SOCKET", runtime / "chroma/worker.sock")
    )
    message: dict[str, Any] = {"protocol": PROTOCOL, "op": operation}
    if payload:
        message.update(json.loads(payload))
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.connect(path)
        client.sendall(json.dumps(message).encode() + b"\n")
        response = b""
        while b"\n" not in response:
            chunk = client.recv(65536)
            if not chunk:
                break
            response += chunk
    result = json.loads(response)
    print(json.dumps(result, indent=2))
    return 0 if result.get("ok") else 1


def main() -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="action", required=True)
    sub.add_parser("serve")
    call = sub.add_parser("request")
    call.add_argument("operation")
    call.add_argument("--json")
    args = parser.parse_args()
    return serve() if args.action == "serve" else request(args.operation, args.json)


if __name__ == "__main__":
    raise SystemExit(main())
