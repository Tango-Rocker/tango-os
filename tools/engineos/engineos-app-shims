#!/usr/bin/env python3
import os
import re
import stat
import sys
import tomllib
from pathlib import Path


def fail(message: str) -> int:
    print(f"engineos-app-shims: {message}", file=sys.stderr)
    return 1


def main() -> int:
    manifest = Path(
        os.environ.get("ENGINEOS_APPS_MANIFEST", "/etc/engineos/apps.toml")
    )
    if not manifest.is_file():
        return fail(f"manifest is not readable: {manifest}")
    try:
        apps = tomllib.loads(manifest.read_text(encoding="utf-8")).get("apps", {})
    except (OSError, tomllib.TOMLDecodeError) as exc:
        return fail(f"manifest is invalid: {exc}")
    destination = Path(
        os.environ.get(
            "ENGINEOS_APP_SHIM_DIR",
            str(Path.home() / ".local" / "bin"),
        )
    )
    destination.mkdir(mode=0o755, parents=True, exist_ok=True)
    expected: set[str] = set()
    for app, definition in apps.items():
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", app):
            return fail(f"apps.{app} is not a safe application identifier")
        commands = definition.get("commands", [])
        if not isinstance(commands, list):
            return fail(f"apps.{app}.commands must be an array")
        for command in commands:
            if (
                not isinstance(command, str)
                or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", command) is None
                or command in expected
            ):
                return fail(f"apps.{app}.commands contains an invalid command")
            expected.add(command)
            path = destination / command
            temporary = destination / f".{command}.tmp.{os.getpid()}"
            temporary.write_text(
                "#!/usr/bin/env sh\n"
                f'exec eos-app launch {app!s} "$@"\n',
                encoding="utf-8",
            )
            temporary.chmod(
                stat.S_IRUSR
                | stat.S_IWUSR
                | stat.S_IXUSR
                | stat.S_IRGRP
                | stat.S_IXGRP
                | stat.S_IROTH
                | stat.S_IXOTH
            )
            temporary.replace(path)
    print(f"generated {len(expected)} EngineOS app shim(s) in {destination}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
