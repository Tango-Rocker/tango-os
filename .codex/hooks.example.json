{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/session_start.py",
            "statusMessage": "Reading EngineOS status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/pre_tool_policy.py",
            "statusMessage": "Checking EngineOS command policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/stop_check.py",
            "statusMessage": "Checking EngineOS handoff notes"
          }
        ]
      }
    ]
  }
}
